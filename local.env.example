# ============================================================
# SK TECH LOCAL ENVIRONMENT
# Copy this file to local.env and enter your own credentials.
# Never publish local.env or commit it to GitHub.
# ============================================================

EBAY_ENABLED=true
EBAY_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_GB

# eBay Partner Network
EBAY_EPN_ENABLED=false
EBAY_EPN_CAMPAIGN_ID=
EBAY_EPN_REFERENCE_ID=SKTECH

# Amazon Product Advertising API
AMAZON_ENABLED=false
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_PARTNER_TYPE=Associates
AMAZON_REGION=eu-west-1
AMAZON_HOST=webservices.amazon.co.uk

# YouTube Discover
YOUTUBE_ENABLED=true
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_MAX_RESULTS=9

# Google Gemini AI
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=45
